{
  "name": "allaparte",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:app": "vite dev",
    "dev:server": "wrangler d1 migrations apply allaparte --local && wrangler dev --port 8787 --assets static",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && wrangler types",
    "check": "svelte-kit sync && wrangler types && tsc -p worker && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --fail-on-warnings",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest run",
    "test": "pnpm run \"/^(build|check|lint|test:unit)$/\"",
    "ensemble:create": "node scripts/create-ensemble.mjs",
    "ensemble:list": "wrangler d1 execute allaparte --command \"SELECT * FROM ensembles\"",
    "deploy:app": "vite build && wrangler d1 migrations apply allaparte --remote && wrangler deploy",
    "deploy:editor": "pnpm build:editor && wrangler deploy --config wrangler.editor.jsonc",
    "build:editor": "cd vendor/viritura && VIRITURA_EXTERNAL_SOUNDFONT=true VITE_VIRITURA_API_BASE_URL=https://editor.allaparte.com pnpm --filter @viritura/editor build",
    "build:viritura": "cd vendor/viritura && pnpm install --frozen-lockfile && pnpm wasm:build && pnpm build:npm-packages && cd ../.. && node scripts/stage-engine.mjs"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#viritura/engine": "./vendor/viritura/packages/score-engine/dist/index.js",
    "#viritura/musicxml": "./vendor/viritura/packages/musicxml/src/index.ts",
    "#viritura/crdt/*": "./vendor/viritura/packages/crdt/src/*"
  },
  "dependencies": {
    "@lucide/svelte": "^1.1.0",
    "kosui": "^0.5.0",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jszip": "^3.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.165.0"
  }
}
