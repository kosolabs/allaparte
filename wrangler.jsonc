{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allaparte",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5180 http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allaparte",
      "database_id": "local",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SIGNALING", "class_name": "Signaling" },
      { "name": "SNAPSHOTS", "class_name": "RoomSnapshot" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Signaling", "RoomSnapshot"] },
  ],
  "limits": { "cpu_ms": 30000 },
}
